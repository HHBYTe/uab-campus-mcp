# Local token path. Docker Compose overrides this with /data/tokens.json.
UAB_TOKEN_FILE=./data/tokens.json
UAB_REQUEST_TIMEOUT_MS=30000

# Required for Streamable HTTP. Generate with: openssl rand -hex 32
MCP_HTTP_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_HOST=127.0.0.1
MCP_PORT=3000
